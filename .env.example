# Copy to .env and adjust. Never commit your real .env.

# Image and container
GRIST_IMAGE=ghcr.io/chefcai/grist-alpine:latest
GRIST_CONTAINER_NAME=grist

# Network: bind to loopback by default; put a reverse proxy in front for remote access.
GRIST_BIND_ADDR=127.0.0.1
GRIST_PORT=8484
APP_HOME_URL=http://localhost:8484

# Grist
GRIST_SINGLE_ORG=docs
GRIST_DEFAULT_EMAIL=admin@example.com
# Generate with: openssl rand -hex 32
GRIST_SESSION_SECRET=
GRIST_SANDBOX_FLAVOR=gvisor
GRIST_TELEMETRY_LEVEL=off

# Storage (local disk recommended)
GRIST_DATA_DIR=./persist

# Resources
GRIST_MEM_LIMIT=768m
